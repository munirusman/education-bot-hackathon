# ---- Runtime -----------------------------------------------------------
#   local        built-in guided tutor in a private directory sandbox (.sandbox/).
#                No API key. Code execution is simulated, never run on the host.
#   claude-code  @ai-sdk/harness-claude-code via a Vercel network sandbox
#                (outbound network denied). Needs ANTHROPIC_API_KEY and Vercel
#                sandbox credentials. Not covered by the automated tests.
HARNESS_ADAPTER=local
ANTHROPIC_API_KEY=

# Optional (local adapter only): answer with a real model on OpenCode Zen instead
# of the scripted pedagogy. The same compiled policy is the system prompt. Zen is
# OpenAI-compatible (chat/completions); ids are listed at
# https://opencode.ai/zen/v1/models. Free models (*-free) work with no key; their
# availability varies (space-bunny-free worked when tested; several others
# returned FreeTierError or "unavailable"). Paid models need ZEN_API_KEY.
# Claude and some GPT models use other Zen endpoints and are not supported here.
TUTOR_MODEL=space-bunny-free
ZEN_API_KEY=
# ZEN_BASE_URL=https://opencode.ai/zen/v1

# ---- Database -----------------------------------------------------------
# Embedded Postgres (PGlite) stored here. ":memory:" for throwaway runs.
PGDATA_PATH=.data/pglite

# ---- Secrets ------------------------------------------------------------
# AES-256-GCM key for resume-state blobs: 64 hex chars. Generated into
# .data/resume.key on first use if unset. Set it explicitly in production.
RESUME_STATE_KEY=

# ---- Ops ----------------------------------------------------------------
# POST /api/admin/reap detaches environments idle longer than this.
IDLE_MINUTES=15
CRON_SECRET=

# ---- App ----------------------------------------------------------------
# Demo mode shows a "pick a user" screen (no auth in the MVP). Set false to
# disable it; there is no other sign-in yet.
DEMO_MODE=true
